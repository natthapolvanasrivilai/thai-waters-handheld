+++ b/verification/browser-tests/observe-paired-reload.cjs
@@ -0,0 +1,88 @@
+'use strict';
+// All browser-local probe data is synthetic. Raw URLs, storage values, hashes,
+// context/frame/loader identifiers, browser IDs and exceptions are never logged.
+function beforeApp(){
+ if(top!==self)return;
+ const read=(area,key)=>{
+  try{
+   const raw=window[area].getItem(key);
+   if(raw===null)return {state:'missing'};
+   let h=2166136261;
+   for(let i=0;i<raw.length;i++)h=Math.imul(h^raw.charCodeAt(i),16777619);
+   return {state:'present',size:raw.length,fingerprint:h>>>0};
+  }catch{return {state:'blocked'};}
+ };
+ const snapshot=()=>({
+  protocol:['file:','http:'].includes(location.protocol)?location.protocol:'other',
+  state:document.readyState,epoch:performance.timeOrigin,type:performance.getEntriesByType('navigation')[0]?.type??null,
+  career:read('localStorage','thai-atlas-v2'),language:read('localStorage','thai-waters-language'),
+  // The canonical test writes only its existing English preference. Do not
+  // introduce a new storage namespace by seeding a separate diagnostic canary.
+  session:read('sessionStorage','__pocket_reel_80_unused_probe')
+ });
+ Object.defineProperty(globalThis,'__pocketReel80Probe',{value:Object.freeze({entry:snapshot(),snapshot})});
+}
+const equal=(a,b)=>a?.state==='present'&&b?.state==='present'?a.size===b.size&&a.fingerprint===b.fingerprint:null;
+const scrub=x=>x?{protocol:x.protocol,documentReady:x.state,navType:x.type,
+ career:x.career.state,language:x.language.state,session:x.session.state}:null;
+function evaluateBoundary(before,entry,after,cert,liveReplayFailed){
+ if(!before||!entry||!after)return 'probe-unavailable';
+ if([cert.sameURL,cert.samePage,cert.sameContext,cert.sameTarget,cert.sameFrame,cert.changedLoader,cert.newDocument].some(x=>x!==true)
+  ||cert.topNavigationCount!==1||entry.state!=='loading'||entry.type!=='reload')return 'unexpected-navigation-identity';
+ if(cert.sameStorageKey===false)return 'storage-key-differed';
+ if(before.career.state!=='present'||before.language.state!=='present')return 'fixture-precondition-failed';
+ if(entry.career.state==='blocked'||entry.language.state==='blocked')return 'access-blocked-before-app';
+ if(entry.career.state==='missing'&&entry.language.state==='missing')return 'career-and-language-missing-before-app';
+ if(entry.career.state==='missing'&&equal(before.language,entry.language))return 'career-only-missing-before-app';
+ if(!equal(before.career,entry.career))return 'career-changed-before-app';
+ if(!equal(entry.career,after.career))return 'career-changed-after-app';
+ if(liveReplayFailed)return 'career-retained-live-assertion-failed';
+ return 'career-retained';
+}
+async function attach(page,captureReloadStartup,readCheckpoint){
+ const context=page.context(),cdp=await context.newCDPSession(page);
+ let nav=0,loader=null,frame=null,current=null;
+ await cdp.send('Page.enable');
+ cdp.on('Page.frameNavigated',e=>{
+  if(e.frame.parentId)return;nav++;loader=e.frame.loaderId;frame=e.frame.id;
+ });
+ // One init script guarantees diagnostic reads precede even the original English write.
+ await page.addInitScript({content:`(${beforeApp.toString()})();(${captureReloadStartup.toString()})();globalThis.__pocketReel80CanonicalCheckpoint=${readCheckpoint.toString()};`});
+ async function nodeIdentity(){
+  const frameId=frame,loaderId=loader,navCount=nav,url=page.url();
+  const t=(await cdp.send('Target.getTargetInfo')).targetInfo;
+  let storageKey=null;
+  try{storageKey=(await cdp.send('Storage.getStorageKeyForFrame',{frameId})).storageKey;}catch{}
+  return {frameId,loaderId,navCount,url,targetId:t.targetId,contextId:t.browserContextId,storageKey};
+ }
+ return {
+  remember(t0,sample){
+   current={t0,sample};
+  },
+  identity:nodeIdentity,
+  async report(stage,passed,pageErrors){
+   if(!current)throw Error('Missing pre-reload observer');
+   const {t0,sample}=current;
+   const t1=await nodeIdentity();
+   const {entry,after}=await page.evaluate(()=>{
+    const m=globalThis.__pocketReel80Probe;
+    return {entry:m?.entry??null,after:m?.snapshot()??null};
+   });
+   const same=(a,b)=>a==null||b==null?null:a===b;
+   const cert={sameURL:t0.url===t1.url,samePage:page.context()===context,sameContext:same(t0.contextId,t1.contextId),
+    sameTarget:same(t0.targetId,t1.targetId),sameFrame:same(t0.frameId,t1.frameId),
+    changedLoader:t0.loaderId==null||t1.loaderId==null?null:t0.loaderId!==t1.loaderId,
+    sameStorageKey:same(t0.storageKey,t1.storageKey),topNavigationCount:t1.navCount-t0.navCount,
+    newDocument:sample?.epoch!=null&&entry?.epoch!=null?sample.epoch!==entry.epoch:null};
+   console.log('paired reload '+JSON.stringify({stage,hardPassed:passed,pageErrors,certificate:cert,
+     before:scrub(sample),preboot:scrub(entry),after:scrub(after),
+     equalCareerToPreboot:equal(sample?.career,entry?.career),equalCareerToAfter:equal(entry?.career,after?.career),
+     equalLanguageToPreboot:equal(sample?.language,entry?.language),classification:evaluateBoundary(sample,entry,after,cert,!passed)}));
+  }
+ };
+}
+const readWithProbe=async arg=>{
+ const result=await globalThis.__pocketReel80CanonicalCheckpoint(arg);
+ return {...result,probe:globalThis.__pocketReel80Probe.snapshot()};
+};
+module.exports={attach,beforeApp,evaluateBoundary,readWithProbe};
